<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Drive detection can go through Google Play services, and whether that is worth
      offering depends on whether Play services itself holds the location and activity
      permissions it needs. Asking that question needs the package to be visible.
      This file is only in the "play" build; the F-Droid build has no Google code.
    -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application>
        <receiver
            android:name=".tracking.DriveDetectReceiver"
            android:exported="false" />
    </application>
</manifest>
